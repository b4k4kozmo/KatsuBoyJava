; Engine configuration file.
; Adventure of Katsu Boy 2D - Godot 4 port of the Java (Swing) version.

config_version=5

[application]

config/name="Adventure of Katsu Boy 2D"
config/description="Godot 4 port of the KatsuboyV2 Java game."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[display]

; Java: screenWidth = tileSize(48) * maxScreenCol(20), screenHeight = 48 * 12
window/size/viewport_width=960
window/size/viewport_height=576
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

; The Java game ran a fixed 60 FPS loop (GamePanel.run()).
; All of the game's counters are frame based, so update() is driven from
; _physics_process() at a fixed 60 ticks per second.
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
