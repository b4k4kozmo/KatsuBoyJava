; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Adventure of Katsu Boy 2D"
config/description="Godot 4 port of the KatsuboyV2 Java game."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"
; The game was written as a fixed 60 FPS loop. Game state now ticks in
; _physics_process regardless, but a couple of cosmetic counters still run per
; drawn frame, so the frame rate is capped to keep them looking the same on a
; 60 Hz and a 144 Hz monitor.
run/max_fps=60

[display]

window/size/viewport_width=960
window/size/viewport_height=576
; Render the game at exactly 960x576 and scale that image to the window.
; "integer" means it is only ever scaled by a whole number, so every source
; pixel ends up the same size on screen - fractional scaling is what makes
; pixel art look lumpy, with some pixels a row wider than their neighbours.
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

